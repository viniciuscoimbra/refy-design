{
  "name": "@refy-design/web",
  "version": "1.5.0",
  "description": "Refy Design System — componentes React atômicos.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "src/stories/BlockFrame.tsx"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/index.js",
      "node": "./dist/node/index.js",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts"
    },
    "./styles.css": "./dist/style.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./global.css": "./src/styles/global.css",
    "./tokens.json": "./src/tokens/foundations.tokens.json",
    "./fonts.css": "./src/styles/fonts.css",
    "./ai/catalog.json": "./ai/catalog.json",
    "./ai/instructions.md": "./ai/instructions.md",
    "./ai/*": "./ai/*",
    "./D3Chart": {
      "types": "./dist/components/Charts/D3Chart.d.ts",
      "react-server": "./dist/components/Charts/D3Chart.js",
      "node": "./dist/node/components/Charts/D3Chart.js",
      "import": "./dist/components/Charts/D3Chart.js"
    },
    "./*": {
      "types": "./dist/components/*/*.d.ts",
      "react-server": "./dist/components/*/*.js",
      "node": "./dist/node/components/*/*.js",
      "import": "./dist/components/*/*.js"
    }
  },
  "scripts": {
    "check:specs": "node scripts/check-specs.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "check": "node scripts/check-component-colors.mjs && npm run tokens:check && npm run contrast:check && npm run motion:check && npm run lint && npm run build && node scripts/check-storybook-deps.mjs && node scripts/check-selective-css.mjs && node scripts/check-messages-split.mjs && node scripts/check-css-budget.mjs && node scripts/check.mjs && npm run check:site-theme && node scripts/check-themes.mjs && npm run check:blocks && npm run docs:check && npm run agent:check",
    "build:site": "vite build --config vite.site.config.ts && node scripts/site-seo.mjs dist-site && node scripts/seo-check.mjs dist-site",
    "seo:indexnow": "node scripts/indexnow.mjs",
    "check:site-theme": "node scripts/check-refy-site.mjs && npm run check:site-contract",
    "prepack": "npm run build && npm run docs:check && npm run agent:build && npm run agent:check",
    "tokens:build": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/check-tokens.mjs",
    "check:colors": "node scripts/check-component-colors.mjs",
    "test:browser": "playwright test",
    "contrast:check": "node scripts/check-contrast.mjs",
    "check:blocks": "node scripts/check-blocks.mjs",
    "docs:build": "node scripts/component-docs.mjs",
    "versions:build": "node scripts/api-history.mjs",
    "docs:check": "node scripts/component-docs.mjs --check --compile && node scripts/api-history.mjs --check && node --test tests/component-usage.test.mjs tests/component-colors.test.mjs tests/brand-logo-symbol.test.mjs tests/site-releases.test.mjs",
    "motion:check": "node scripts/check-motion.mjs",
    "check:site-contract": "node scripts/refy-site-harness.mjs --contract",
    "check:site-visual": "node scripts/refy-site-harness.mjs --compare",
    "check:site-acceptance": "node scripts/refy-site-harness.mjs --acceptance",
    "agent:build": "node scripts/agent-kit.mjs",
    "mcp:worker": "node workers/mcp/build.mjs",
    "mcp:smoke": "node workers/mcp/smoke.mjs",
    "agent:check": "node scripts/agent-kit.mjs --check && node --test tests/agent-kit.test.mjs tests/agent-discovery.test.mjs tests/collection-registry.test.mjs tests/agent-collections.test.mjs tests/agent-init.test.mjs tests/agent-mcp.test.mjs tests/agent-theme-extract.test.mjs tests/agent-compare.test.mjs tests/agent-plugin.test.mjs tests/agent-mcp-remote.test.mjs tests/agent-check-guidance.test.mjs tests/agent-theme-precedence.test.mjs tests/agent-check-hooks.test.mjs tests/readme-facts.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@types/d3-array": "^3.2.2",
    "@types/d3-brush": "^3.0.6",
    "@types/d3-chord": "^3.0.6",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.14.0",
    "buffer": "^6.0.3",
    "esbuild": "0.25.12",
    "gsap": "3.15.1",
    "prettier": "^3.9.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "^0.81.5",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.4",
    "storybook": "^8.6.19",
    "typescript": "^5.5.0",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/geojson": "^7946.0.16",
    "d3-array": "^3.2.4",
    "d3-brush": "^3.0.0",
    "d3-chord": "^3.0.1",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "prismjs": "^1.30.0"
  },
  "main": "./dist/node/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/tokens/tokens.css",
    "src/styles/global.css",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "src/tokens/foundations.tokens.json",
    "src/styles/fonts.css",
    "src/assets/fonts",
    "docs/*.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "ai",
    "tools/refy-agent"
  ],
  "author": "Vinícius Coimbra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viniciuscoimbra/refy-design.git"
  },
  "homepage": "https://github.com/viniciuscoimbra/refy-design#readme",
  "bugs": {
    "url": "https://github.com/viniciuscoimbra/refy-design/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@storybook/addon-actions": {
      "uuid": "11.1.1"
    },
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": {
        ".": "14.0.2",
        "minimatch": "11.0.1"
      }
    }
  },
  "bin": {
    "refy": "./tools/refy-agent/cli.mjs",
    "refy-agent": "./tools/refy-agent/cli.mjs",
    "refy-mcp": "./tools/refy-agent/mcp.mjs"
  }
}
