{
  "name": "@refy-design/a2ui",
  "version": "0.2.0",
  "description": "Refy components as an A2UI 1.0 catalog (id https://refy.design/a2ui/v1) for React on the web and React Native.",
  "license": "MIT",
  "author": "Vinícius Coimbra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viniciuscoimbra/refy-design.git",
    "directory": "packages/a2ui"
  },
  "homepage": "https://github.com/viniciuscoimbra/refy-design/tree/main/packages/a2ui#readme",
  "bugs": {
    "url": "https://github.com/viniciuscoimbra/refy-design/issues"
  },
  "keywords": [
    "a2ui",
    "design-system",
    "refy",
    "react",
    "react-native",
    "agents"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./definition": {
      "types": "./dist/definition.d.ts",
      "default": "./dist/definition.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "react-native": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./catalog.css": "./dist/catalog.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node test/run.mjs",
    "demo": "vite --config vite.config.ts",
    "proof": "node proof/proof.mjs"
  },
  "dependencies": {
    "@a2ui/web_core": "0.15.0",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "@a2ui/react": "0.15.0",
    "@refy-design/mobile": "^1.1.0",
    "@refy-design/web": "^1.8.0",
    "react": ">=19",
    "react-dom": ">=19",
    "react-native": ">=0.79"
  },
  "devDependencies": {
    "@a2ui/react": "0.15.0",
    "@refy-design/mobile": "^1.1.0",
    "@refy-design/web": "1.8.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.25.12",
    "playwright": "1.64.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "^0.81.4",
    "react-native-svg": "^15.12.1",
    "typescript": "^5.5.0",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependenciesMeta": {
    "@a2ui/react": {
      "optional": true
    },
    "@refy-design/mobile": {
      "optional": true
    },
    "@refy-design/web": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  }
}
