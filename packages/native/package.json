{
  "name": "@refy-design/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Componentes do Refy em React Native, com o mesmo contrato de props da web.",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest"
  },
  "dependencies": {
    "@refy/tokens": "file:../tokens",
    "d3-array": "^3.2.4",
    "d3-chord": "^3.0.1",
    "d3-force": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "peerDependencies": {
    "@refy-design/web": "*",
    "react": ">=19.1",
    "react-native": ">=0.76",
    "react-native-svg": ">=15"
  },
  "peerDependenciesMeta": {
    "@refy-design/web": {
      "optional": true
    }
  },
  "jest": {
    "preset": "react-native",
    "moduleNameMapper": {
      "^@refy-design/web/contracts$": "<rootDir>/../../src/contracts/index.ts",
      "^@refy/tokens$": "<rootDir>/../tokens/dist/index.js",
      "\\.module\\.css$": "<rootDir>/test/css-stub.cjs"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-svg|d3-.*|internmap|delaunator|robust-predicates)/)"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx|mjs)$": "babel-jest"
    }
  }
}
