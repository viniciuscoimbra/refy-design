{
  "id": "Fab",
  "description": "Main floating action, compact or with a label.",
  "usage": {
    "howToUse": [
      "Use it for the one action people take most on a mobile screen: new message, new task, add photo.",
      "Keep one per screen, in the lower corner, above the content.",
      "Pass an `icon` and an `aria-label`. Use `extended` with `label` when the icon alone is not clear."
    ],
    "alternatives": [
      "Several related actions from the same corner: FabMenu.",
      "Desktop screens, where the action fits in the header: Button."
    ],
    "keyboard": [
      {
        "keys": "`Tab`",
        "action": "Moves focus to the button."
      },
      {
        "keys": "`Enter` or `Space`",
        "action": "Runs the action."
      }
    ]
  },
  "collections": [
    "core"
  ],
  "publicName": "Fab",
  "selected": "FabPadrao",
  "import": "import { Fab } from '@refy-design/web';",
  "composition": [],
  "api": [
    {
      "name": "Fab",
      "props": [
        {
          "name": "icon",
          "type": "ReactNode",
          "required": true,
          "description": "Icon (required; it is the subject of the FAB)."
        },
        {
          "name": "label",
          "type": "string | undefined",
          "required": false,
          "description": "If present and `extended`, becomes an extended FAB with text."
        },
        {
          "name": "extended",
          "defaultValue": "false",
          "type": "boolean | undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "size",
          "defaultValue": "\"lg\"",
          "type": "FabSize | undefined",
          "required": false,
          "description": "Size variant."
        },
        {
          "name": "variant",
          "defaultValue": "\"primary\"",
          "type": "FabVariant | undefined",
          "required": false,
          "description": "Visual variant."
        },
        {
          "name": "disabled",
          "type": "boolean | undefined",
          "required": false,
          "description": "Disables interaction."
        },
        {
          "name": "type",
          "type": "\"submit\" | \"reset\" | \"button\" | undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "value",
          "type": "string | number | readonly string[] | undefined",
          "required": false,
          "description": "Value in controlled state."
        },
        {
          "name": "defaultValue",
          "type": "string | number | readonly string[] | undefined",
          "required": false,
          "description": "Initial value in uncontrolled state."
        },
        {
          "name": "className",
          "type": "string | undefined",
          "required": false,
          "description": "Extra CSS class."
        },
        {
          "name": "dir",
          "type": "string | undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "id",
          "type": "string | undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "style",
          "type": "CSSProperties | undefined",
          "required": false,
          "description": "The component's inline styles."
        },
        {
          "name": "aria-label",
          "type": "string | undefined",
          "required": false,
          "description": "Defines a string value that labels the current element."
        },
        {
          "name": "children",
          "type": "ReactNode",
          "required": false,
          "description": "Content shown by the component."
        },
        {
          "name": "onFocus",
          "type": "FocusEventHandler<HTMLButtonElement> | undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "onBlur",
          "type": "FocusEventHandler<HTMLButtonElement> | undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "onChange",
          "type": "ChangeEventHandler<HTMLButtonElement, Element> | undefined",
          "required": false,
          "description": "Callback called when the value changes."
        },
        {
          "name": "onKeyDown",
          "type": "KeyboardEventHandler<HTMLButtonElement> | undefined",
          "required": false,
          "description": ""
        },
        {
          "name": "onClick",
          "type": "MouseEventHandler<HTMLButtonElement> | undefined",
          "required": false,
          "description": "Activation callback."
        }
      ]
    }
  ],
  "examples": [
    {
      "id": "FabPadrao",
      "label": "Default",
      "description": "Round, icon only (the label becomes aria-label).",
      "code": "import { Fab } from '@refy-design/web';\nimport type { ComponentProps } from 'react';\nimport type { ReactNode } from 'react';\nconst s = (children: ReactNode) => (\n  <svg\n    viewBox=\"0 0 24 24\"\n    fill=\"none\"\n    stroke=\"currentColor\"\n    strokeWidth={1.7}\n    strokeLinecap=\"round\"\n    strokeLinejoin=\"round\"\n  >\n    {children}\n  </svg>\n);\nconst Icons = {\n  desktop: s(\n    <>\n      <rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\" />\n      <path d=\"M8 21h8M12 16v5\" />\n    </>,\n  ),\n  tablet: s(\n    <>\n      <rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"2\" />\n      <path d=\"M11 17h2\" />\n    </>,\n  ),\n  phone: s(\n    <>\n      <rect x=\"6\" y=\"2\" width=\"12\" height=\"20\" rx=\"2\" />\n      <path d=\"M11 18h2\" />\n    </>,\n  ),\n  code: s(\n    <>\n      <path d=\"m8 6-6 6 6 6m8-12 6 6-6 6M14 4l-4 16\" />\n    </>,\n  ),\n  dashboard: s(\n    <>\n      <rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" />\n      <rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" />\n      <rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" />\n      <rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" />\n    </>,\n  ),\n  projects: s(\n    <>\n      <path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\" />\n    </>,\n  ),\n  backlog: s(\n    <>\n      <path d=\"M9 11l3 3L22 4\" />\n      <path d=\"M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11\" />\n    </>,\n  ),\n  monitor: s(\n    <>\n      <path d=\"M2 12s3-7 10-7 10 7 10 7-3 7-10 7S2 12 2 12z\" />\n      <circle cx=\"12\" cy=\"12\" r=\"3\" />\n    </>,\n  ),\n  competitors: s(\n    <>\n      <line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\" />\n      <line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\" />\n      <line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\" />\n    </>,\n  ),\n  bell: s(\n    <>\n      <path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9\" />\n      <path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\" />\n    </>,\n  ),\n  settings: