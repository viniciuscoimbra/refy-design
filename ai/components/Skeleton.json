          "type": "string | number | undefined",
          "required": false,
          "description": "Width (number = px). Default 100%."
        },
        {
          "name": "height",
          "defaultValue": "14",
          "type": "string | number | undefined",
          "required": false,
          "description": "Height (number = px). Default 14px (text line)."
        },
        {
          "name": "circle",
          "type": "boolean | undefined",
          "required": false,
          "description": "Circle (avatar). Uses `width` as the diameter."
        },
        {
          "name": "defaultValue",
